---
import TagList from "./TagList.astro";
import Icon from "./Icon.astro";
import type { Project } from "@data/projects";
const { project, index, variant = "card" } = Astro.props as { project: Project; index?: number; variant?: "card" | "row" };
---

<article class:list={["project-card", { card: variant === "card", "project-row": variant === "row" }]}>
  {index !== undefined && <span class="project-index mono-label">{String(index).padStart(2, "0")}</span>}
  <div class="card-body">
    <p class="project-status">{project.status}</p>
    <h3>{project.shortTitle ?? project.title}</h3>
    <p class="project-summary">{project.summary}</p>
    <TagList tags={project.tags.slice(0, 4)} />
    {project.highlights && <details class="project-details"><summary>Model details <span aria-hidden="true">+</span></summary><ul class="project-highlights">{project.highlights.map((highlight) => <li>{highlight}</li>)}</ul></details>}
    {project.preprint && <p class="preprint-note">Preprint · DOI: {project.preprint.doi}</p>}
    <div class="link-list" aria-label={`${project.title} links`}>
      {project.links.slice(0, 2).map((link) => <a href={link.url} target="_blank" rel="noreferrer" aria-label={`${link.label} (opens in a new tab)`}>{link.kind === "code" && <Icon name="github" size={16} />}{link.kind === "code" ? "Code" : link.kind === "paper" ? "Preprint" : "Documentation"}<Icon name="external" size={13} /></a>)}
    </div>
  </div>
</article>
