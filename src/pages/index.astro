---
import BaseLayout from "@layouts/BaseLayout.astro";
import Icon from "@components/Icon.astro";
import ExperimentViewer from "@components/ExperimentViewer.astro";
import ProjectCard from "@components/ProjectCard.astro";
import SimulationCard from "@components/SimulationCard.astro";
import { projects } from "@data/projects";
import { tropicalBandCases, simulationCases } from "@data/simulations";

const flagship = projects[0];
const selectedProjects = projects.slice(1, 4);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const internalUrl = (path: string) => `${base}${path}`;
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dash" aria-hidden="true"></span>Atmospheric science & scientific computing</p>
        <h1 id="hero-heading">Chin-Wei<br /><em>(Aaron) Hsieh</em></h1>
        <p class="hero-intro">Atmospheric scientist & model developer</p>
        <p class="hero-description">I develop atmospheric models, from numerical formulation and GPU/HPC implementation to verification and scientific analysis.</p>
        <div class="button-row" aria-label="Primary links">
          <a class="button" href={internalUrl("/simulations/")}>Explore simulations <Icon /></a>
          <a class="text-link" href="#selected-projects">View my research <Icon name="external" size={17} /></a>
        </div>
        <div class="hero-affiliation"><span class="status-dot" aria-hidden="true"></span>Research Assistant · National Taiwan University</div>
      </div>
      <ExperimentViewer />
    </div>
    <div class="container research-strip" aria-label="Research focus">
      <span class="strip-label">Research areas</span>
      <a href="#research-direction">Cloud-resolving models <Icon name="external" size={15} /></a>
      <a href={internalUrl("/workflow/")}>GPU & HPC development <Icon name="external" size={15} /></a>
      <a href={internalUrl("/projects/")}>Multiscale dynamics <Icon name="external" size={15} /></a>
    </div>
  </section>

  <section class="section research-section" id="selected-projects" aria-labelledby="research-heading">
    <div class="container">
      <div class="section-heading-row">
        <div><p class="eyebrow">01 / Research</p><h2 id="research-heading">Selected projects</h2></div>
        <a class="text-link" href={internalUrl("/projects/")}>All projects <span class="link-count">{projects.length}</span><Icon size={18} /></a>
      </div>
      <article class="flagship-project">
        <a class="flagship-image" href={flagship.links[1].url} target="_blank" rel="noreferrer" aria-label="Explore the VVMex documentation (opens in a new tab)">
          <div class="image-overline"><span class="status-dot" aria-hidden="true"></span>VVMex / Full-physics LES <Icon name="external" size={17} /></div>
          <img src={internalUrl("/assets/taiwan-vvm-precipitation.png")} width="760" height="600" alt="TaiwanVVM simulation showing precipitation and wind over Taiwan’s complex terrain" loading="lazy" />
          <div class="image-footnote">TaiwanVVM<span>Dynamics × Terrain × Physics</span></div>
        </a>
        <div class="flagship-copy">
          <p class="eyebrow">Featured project <span class="tiny-divider">/</span> Active development</p>
          <h3>VVMex<span>GPU-capable cloud-resolving model</span></h3>
          <p>{flagship.summary}</p>
          <ul class="flagship-points"><li>GPU-resident dynamics and coupled physics</li><li>From idealized benchmarks to complex terrain</li><li>Modular, portable, and built for research</li></ul>
          <div class="flagship-bottom"><span class="mono-label">C++17 · Kokkos · MPI · CUDA</span><div class="link-list"><a href={flagship.links[0].url} target="_blank" rel="noreferrer"><Icon name="github" size={17} />Code <Icon name="external" size={13} /></a><a href={flagship.links[1].url} target="_blank" rel="noreferrer">Documentation <Icon name="external" size={13} /></a></div></div>
        </div>
      </article>
      <div class="project-list">
        {selectedProjects.map((project, index) => <ProjectCard project={project} index={index + 2} variant="row" />)}
      </div>
    </div>
  </section>

  <section class="section simulation-section" aria-labelledby="simulations-heading">
    <div class="container">
      <div class="section-heading-row">
        <div><p class="eyebrow">02 / Simulations</p><h2 id="simulations-heading">Featured simulations</h2></div>
        <a class="text-link" href={internalUrl("/simulations/")}>Browse the gallery <span class="link-count">{simulationCases.length}</span><Icon size={18} /></a>
      </div>
      <p class="section-intro">From an idealized ocean to the Maritime Continent. Two experiments exploring the connection between surface forcing and tropical waves.</p>
      <div class="simulation-grid">{tropicalBandCases.map((item, index) => <SimulationCard item={item} index={index + 1} />)}</div>
    </div>
  </section>

  <section class="section direction-section" id="research-direction" aria-labelledby="direction-heading">
    <div class="container direction-grid">
      <div><p class="eyebrow">03 / Research interests</p><h2 id="direction-heading">Atmospheric modeling</h2><a class="text-link" href={internalUrl("/cv/")}>More about my background <Icon size={18} /></a></div>
      <div class="direction-copy"><p class="direction-lead">Cloud-resolving dynamics, coupled physics, and high-performance computing.</p><p>My work connects cloud-resolving dynamics, land–atmosphere coupling, radiation, microphysics, and complex terrain. I develop models from numerical formulation to GPU/HPC implementation, verification, and scientific analysis.</p></div>
    </div>
  </section>
</BaseLayout>
