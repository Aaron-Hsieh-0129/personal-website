---
import BaseLayout from "@layouts/BaseLayout.astro";
import Icon from "@components/Icon.astro";
import { profile } from "@data/profile";
const contactLinks = [
  { label: "Email", value: profile.emailLabel, href: profile.email, icon: "mail" as const },
  { label: "GitHub", value: "Aaron-Hsieh-0129", href: profile.githubUrl, icon: "github" as const },
  { label: "ORCID", value: profile.orcidLabel, href: profile.orcidUrl, icon: "globe" as const },
];
---

<BaseLayout title="Contact" description="Contact links for Chin-Wei Aaron Hsieh.">
  <section class="page-title">
    <div class="container">
      <p class="eyebrow">Email & academic profiles</p>
      <h1>Contact</h1>
      <p class="lead">For questions about my research, atmospheric models, or scientific computing, send me a note.</p>
    </div>
  </section>
  <section class="section">
    <div class="container contact-layout">
      <div class="contact-intro"><h2>Email and profiles</h2><p>I work at the intersection of atmospheric science and high-performance computation. You can find my models and tools on GitHub, or reach me directly by email.</p></div>
      <div>
        <div class="contact-links">
          {contactLinks.map((item) => <a class="contact-item" href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noreferrer" : undefined}><span class="contact-icon"><Icon name={item.icon} size={20} /></span><div><h3>{item.label}</h3><p>{item.value}</p></div><Icon name="external" size={20} /></a>)}
        </div>
        <p class="contact-note">A full CV is available on request.</p>
      </div>
    </div>
  </section>
</BaseLayout>
